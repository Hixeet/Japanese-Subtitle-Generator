[
  {
    "start": 1.0,
    "end": 6.0,
    "text": "はぁ…はぁ…はぁ…"
  },
  {
    "start": 13.0,
    "end": 16.0,
    "text": "我が騎士、来た時とは道が違いますね"
  },
  {
    "start": 17.0,
    "end": 19.0,
    "text": "次の指令が出たからな"
  },
  {
    "start": 20.0,
    "end": 23.0,
    "text": "勇者に決まった道なんじゃねぇよ"
  },
  {
    "start": 31.0,
    "end": 34.0,
    "text": "人通りが増えてきましたね"
  },
  {
    "start": 34.0,
    "end": 39.0,
    "text": "これから行く先で、ちょっとしたお祭りがありますから"
  },
  {
    "start": 40.0,
    "end": 42.0,
    "text": "ところで、財路君"
  },
  {
    "start": 42.0,
    "end": 43.0,
    "text": "ああ"
  },
  {
    "start": 44.0,
    "end": 48.0,
    "text": "そろそろ、休憩にしませんか"
  },
  {
    "start": 49.0,
    "end": 51.0,
    "text": "さっき休んだばっかだ"
  },
  {
    "start": 51.0,
    "end": 52.0,
    "text": "もう…"
  },
  {
    "start": 61.0,
    "end": 63.0,
    "text": "あれが目的地ですか?"
  },
  {
    "start": 63.0,
    "end": 64.0,
    "text": "ええ"
  },
  {
    "start": 64.0,
    "end": 69.0,
    "text": "第2応答への防衛拠点として、従業度の高い要塞です"
  },
  {
    "start": 69.0,
    "end": 73.0,
    "text": "タイガと弾害に守られた天皇の要塞"
  },
  {
    "start": 76.0,
    "end": 77.0,
    "text": "ミュウリッド要塞"
  },
  {
    "start": 77.0,
    "end": 80.0,
    "text": "別名、渡り鳥の巣だ"
  },
  {
    "start": 85.0,
    "end": 86.0,
    "text": "安いよ安いよ!"
  },
  {
    "start": 86.0,
    "end": 88.0,
    "text": "新鮮なものは今だけだよ!"
  },
  {
    "start": 88.0,
    "end": 89.0,
    "text": "お兄さん、お目が高い!"
  },
  {
    "start": 91.0,
    "end": 94.0,
    "text": "おっと、ドッピョンが足りねぇな"
  },
  {
    "start": 94.0,
    "end": 96.0,
    "text": "これ、5つもらえる?"
  },
  {
    "start": 97.0,
    "end": 99.0,
    "text": "手紙どうしたよ、タイメーカー!"
  },
  {
    "start": 100.0,
    "end": 102.0,
    "text": "これを、母の音で"
  },
  {
    "start": 108.0,
    "end": 111.0,
    "text": "修理場から戻った途端にこれですか"
  },
  {
    "start": 111.0,
    "end": 113.0,
    "text": "ドッタ君は取りませんね"
  },
  {
    "start": 113.0,
    "end": 115.0,
    "text": "平気平気"
  },
  {
    "start": 115.0,
    "end": 119.0,
    "text": "少しぐらい盗んでも怒られないってお祭りなんですし"
  },
  {
    "start": 119.0,
    "end": 123.0,
    "text": "幾ら久しぶりの大初歩だからって、バレたら大変ですよ"
  },
  {
    "start": 123.0,
    "end": 127.0,
    "text": "バークル開拓校舎の承認はがめついですから"
  },
  {
    "start": 129.0,
    "end": 134.0,
    "text": "まあまあ固いこといい子なし、せっかくの休暇を楽しもうよ"
  },
  {
    "start": 135.0,
    "end": 138.0,
    "text": "我々勇者の休暇という概念はありません"
  },
  {
    "start": 138.0,
    "end": 142.0,
    "text": "今はあくまでも、待機という状態です"
  },
  {
    "start": 142.0,
    "end": 148.0,
    "text": "まあ多少は急速、担いた時間を過ごすことも可能ですが"
  },
  {
    "start": 149.0,
    "end": 155.0,
    "text": "うーん、ベネキンってそれっぽいことばっか言うよね"
  },
  {
    "start": 159.0,
    "end": 163.0,
    "text": "あとは女の子さえいるかな"
  },
  {
    "start": 163.0,
    "end": 167.0,
    "text": "やめましょ、たとえその手の店があったところで"
  },
  {
    "start": 167.0,
    "end": 170.0,
    "text": "利用許可が出るはずもないですから"
  },
  {
    "start": 170.0,
    "end": 172.0,
    "text": "だよねー"
  },
  {
    "start": 173.0,
    "end": 176.0,
    "text": "ソースリー、どうにいる?"
  },
  {
    "start": 176.0,
    "end": 178.0,
    "text": "ザイロソースリー!"
  },
  {
    "start": 178.0,
    "end": 179.0,
    "text": "あ?"
  },
  {
    "start": 179.0,
    "end": 183.0,
    "text": "ザイロソースリー、幼少人が来ているぞ"
  },
  {
    "start": 183.0,
    "end": 185.0,
    "text": "世のワインを買ってまいれ"
  },
  {
    "start": 185.0,
    "end": 189.0,
    "text": "残念ながら我が王国の国庫は殻だ"
  },
  {
    "start": 189.0,
    "end": 192.0,
    "text": "分評を使い知ったの忘れちまったのか"
  },
  {
    "start": 192.0,
    "end": 196.0,
    "text": "酒が欲しいなら、借金して買いに行くんだな"
  },
  {
    "start": 196.0,
    "end": 198.0,
    "text": "ベネティムとか暇だろ"
  },
  {
    "start": 198.0,
    "end": 201.0,
    "text": "最初はテクセの悪いドッターを監視しておる"
  },
  {
    "start": 201.0,
    "end": 204.0,
    "text": "あいつ、また敵となこと言って"
  },
  {
    "start": 204.0,
    "end": 205.0,
    "text": "サーブは?"
  },
  {
    "start": 205.0,
    "end": 207.0,
    "text": "まだ任務から戻っておらんのか"
  },
  {
    "start": 207.0,
    "end": 210.0,
    "text": "ああ、どっかの部隊に貸し出されてる"
  },
  {
    "start": 211.0,
    "end": 213.0,
    "text": "といつも、こいつも"
  },
  {
    "start": 213.0,
    "end": 215.0,
    "text": "王に対するって"
  },
  {
    "start": 216.0,
    "end": 219.0,
    "text": "毒処くらい静かにさせろってんだ"
  },
  {
    "start": 222.0,
    "end": 225.0,
    "text": "我が騎士、ここにいたのですね"
  },
  {
    "start": 226.0,
    "end": 228.0,
    "text": "次から次へと"
  },
  {
    "start": 228.0,
    "end": 232.0,
    "text": "扉が開いていましたが、無用心すぎではありませんか?"
  },
  {
    "start": 232.0,
    "end": 234.0,
    "text": "ドッターが開けて出て行ったんだ"
  },
  {
    "start": 234.0,
    "end": 236.0,
    "text": "鍵をあいつが持ってる"
  },
  {
    "start": 236.0,
    "end": 239.0,
    "text": "我が騎士は大使法に行かないのですか?"
  },
  {
    "start": 239.0,
    "end": 241.0,
    "text": "聖騎士たちに会いたくねえ"
  },
  {
    "start": 241.0,
    "end": 244.0,
    "text": "では、起きて私と遊びなさい"
  },
  {
    "start": 244.0,
    "end": 246.0,
    "text": "なんでだよ"
  },
  {
    "start": 246.0,
    "end": 248.0,
    "text": "お前こそ大使法に行けばいいだろ"
  },
  {
    "start": 248.0,
    "end": 251.0,
    "text": "わ、私は女神ですから"
  },
  {
    "start": 251.0,
    "end": 254.0,
    "text": "ああいうものに興味などありません"
  },
  {
    "start": 255.0,
    "end": 258.0,
    "text": "聖騎士の見張りがつくのは嫌か"
  },
  {
    "start": 258.0,
    "end": 261.0,
    "text": "その話はもういいです"
  },
  {
    "start": 261.0,
    "end": 266.0,
    "text": "それより、あなたに私と遊ぶ名誉をあげましょう"
  },
  {
    "start": 266.0,
    "end": 268.0,
    "text": "うれしいですよね"
  },
  {
    "start": 268.0,
    "end": 269.0,
    "text": "ジグか"
  },
  {
    "start": 269.0,
    "end": 272.0,
    "text": "ベネティムから遊び方を教えてもらいました"
  },
  {
    "start": 272.0,
    "end": 275.0,
    "text": "そう簡単には負けませんよ"
  },
  {
    "start": 275.0,
    "end": 279.0,
    "text": "これはかつて、メト王国の旧帝で使われていた"
  },
  {
    "start": 279.0,
    "end": 282.0,
    "text": "優勝正式シノビアリという戦い方で"
  },
  {
    "start": 282.0,
    "end": 283.0,
    "text": "やめとけ"
  },
  {
    "start": 283.0,
    "end": 287.0,
    "text": "ベネティムから聞いたならどうせ騙されている"
  },
  {
    "start": 289.0,
    "end": 292.0,
    "text": "とにかく俺は忙しいんだ"
  },
  {
    "start": 292.0,
    "end": 294.0,
    "text": "え、本ですか?"
  },
  {
    "start": 294.0,
    "end": 296.0,
    "text": "後で読めばいいではありませんか"
  },
  {
    "start": 296.0,
    "end": 298.0,
    "text": "ちょうど塩利も作りましたし"
  },
  {
    "start": 298.0,
    "end": 300.0,
    "text": "知るか、自分ですか"
  },
  {
    "start": 300.0,
    "end": 302.0,
    "text": "うむ"
  },
  {
    "start": 302.0,
    "end": 304.0,
    "text": "それにしても"
  },
  {
    "start": 304.0,
    "end": 307.0,
    "text": "ザイロが特殊好きとは意外ですね"
  },
  {
    "start": 307.0,
    "end": 309.0,
    "text": "何を読んでいるのです"
  },
  {
    "start": 309.0,
    "end": 310.0,
    "text": "詩衆だよ"
  },
  {
    "start": 310.0,
    "end": 312.0,
    "text": "詩衆?"
  },
  {
    "start": 313.0,
    "end": 315.0,
    "text": "ザイロ…"
  },
  {
    "start": 315.0,
    "end": 317.0,
    "text": "あ、あなたが"
  },
  {
    "start": 317.0,
    "end": 319.0,
    "text": "おい、なんで驚く"
  },
  {
    "start": 319.0,
    "end": 321.0,
    "text": "どんな詩衆なのです"
  },
  {
    "start": 321.0,
    "end": 324.0,
    "text": "私に読んで聞かせる英語を与えます"
  },
  {
    "start": 324.0,
    "end": 325.0,
    "text": "ことある"
  },
  {
    "start": 326.0,
    "end": 329.0,
    "text": "でしたら一緒に読むぐらいはいいでしょう"
  },
  {
    "start": 329.0,
    "end": 331.0,
    "text": "いいですよね"
  },
  {
    "start": 331.0,
    "end": 335.0,
    "text": "女神様の気に入るようなものじゃねぇよ"
  },
  {
    "start": 335.0,
    "end": 339.0,
    "text": "流水という古い時代の詩衆だ"
  },
  {
    "start": 339.0,
    "end": 341.0,
    "text": "見たのはアルトヤードコメってという"
  },
  {
    "start": 341.0,
    "end": 343.0,
    "text": "酔っ払いの詩衆だ"
  },
  {
    "start": 343.0,
    "end": 346.0,
    "text": "断念はドラゴンになりたいって妄想が始まり"
  },
  {
    "start": 346.0,
    "end": 349.0,
    "text": "夜のような空を飛ぶ練習をして死んじまった"
  },
  {
    "start": 349.0,
    "end": 353.0,
    "text": "ああ、変わったことですね"
  },
  {
    "start": 353.0,
    "end": 356.0,
    "text": "この時代の詩衆はそういう奴が多い"
  },
  {
    "start": 356.0,
    "end": 360.0,
    "text": "俺も軍人にならなかったら詩衆を目指していたかもな"
  },
  {
    "start": 360.0,
    "end": 361.0,
    "text": "詩衆!"
  },
  {
    "start": 361.0,
    "end": 363.0,
    "text": "なんだよ"
  },
  {
    "start": 363.0,
    "end": 365.0,
    "text": "ザイロフォルバーツ"
  },
  {
    "start": 365.0,
    "end": 367.0,
    "text": "ここにいたのか"
  },
  {
    "start": 367.0,
    "end": 370.0,
    "text": "テオリッタ様も一緒とは思いませんでした"
  },
  {
    "start": 370.0,
    "end": 374.0,
    "text": "キービア!私もあなたが来るとは思いませんでした"
  },
  {
    "start": 374.0,
    "end": 376.0,
    "text": "はっ!"
  },
  {
    "start": 376.0,
    "end": 380.0,
    "text": "高級な正規社団長さんがこんな場所までおいでとはな"
  },
  {
    "start": 380.0,
    "end": 383.0,
    "text": "ついに俺たちの諸軍が決まったか"
  },
  {
    "start": 383.0,
    "end": 386.0,
    "text": "それとも次の作戦か"
  },
  {
    "start": 386.0,
    "end": 388.0,
    "text": "どちらも正解ではある"
  },
  {
    "start": 388.0,
    "end": 391.0,
    "text": "ただ私の要は違う"
  },
  {
    "start": 391.0,
    "end": 393.0,
    "text": "貴様に話がある"
  },
  {
    "start": 393.0,
    "end": 395.0,
    "text": "俺にはね"
  },
  {
    "start": 396.0,
    "end": 397.0,
    "text": "ついてこい"
  },
  {
    "start": 397.0,
    "end": 398.0,
    "text": "鍵は"
  },
  {
    "start": 398.0,
    "end": 400.0,
    "text": "私も行きます"
  },
  {
    "start": 400.0,
    "end": 401.0,
    "text": "は?"
  },
  {
    "start": 401.0,
    "end": 404.0,
    "text": "大手ほどやらも開かれているようですから"
  },
  {
    "start": 404.0,
    "end": 407.0,
    "text": "買い物でもしながら話すのがいいと思います"
  },
  {
    "start": 407.0,
    "end": 408.0,
    "text": "キリアがいるなら"
  },
  {
    "start": 408.0,
    "end": 411.0,
    "text": "女神の私が言っても問題ないはずです"
  },
  {
    "start": 411.0,
    "end": 414.0,
    "text": "ええ!それが良いでしょう"
  },
  {
    "start": 414.0,
    "end": 416.0,
    "text": "さあ、行きますよ、わがきし"
  },
  {
    "start": 416.0,
    "end": 418.0,
    "text": "はぁ"
  },
  {
    "start": 426.0,
    "end": 428.0,
    "text": "ザイロ!みなさい!"
  },
  {
    "start": 428.0,
    "end": 432.0,
    "text": "あれは食べ物ですか?それとも何かの飾りでしょうか"
  },
  {
    "start": 432.0,
    "end": 434.0,
    "text": "雨だな"
  },
  {
    "start": 434.0,
    "end": 436.0,
    "text": "見たことないのか"
  },
  {
    "start": 436.0,
    "end": 438.0,
    "text": "あ、ねえ"
  },
  {
    "start": 438.0,
    "end": 441.0,
    "text": "私が作られた時代にはありませんでした"
  },
  {
    "start": 441.0,
    "end": 444.0,
    "text": "まるで法食品のように見えますね"
  },
  {
    "start": 444.0,
    "end": 445.0,
    "text": "ん?"
  },
  {
    "start": 447.0,
    "end": 449.0,
    "text": "あのこそ長い食べ物は?"
  },
  {
    "start": 449.0,
    "end": 451.0,
    "text": "正面だな"
  },
  {
    "start": 451.0,
    "end": 453.0,
    "text": "正方の料理は"
  },
  {
    "start": 453.0,
    "end": 456.0,
    "text": "細長くした小麦をバターと必要で焼く"
  },
  {
    "start": 456.0,
    "end": 458.0,
    "text": "ああ、なるほど"
  },
  {
    "start": 458.0,
    "end": 460.0,
    "text": "ならばあちらの"
  },
  {
    "start": 460.0,
    "end": 462.0,
    "text": "こら、クマの缶番の"
  },
  {
    "start": 462.0,
    "end": 464.0,
    "text": "あれは"
  },
  {
    "start": 464.0,
    "end": 466.0,
    "text": "何だ?見たことないの?"
  },
  {
    "start": 466.0,
    "end": 468.0,
    "text": "ミューリーズクリームだ"
  },
  {
    "start": 468.0,
    "end": 470.0,
    "text": "第一オートで人気の氷がして"
  },
  {
    "start": 470.0,
    "end": 473.0,
    "text": "泡立てたクリームの上に削った氷をのせて"
  },
  {
    "start": 473.0,
    "end": 475.0,
    "text": "はちみつやナッツをまぶす"
  },
  {
    "start": 475.0,
    "end": 476.0,
    "text": "非常に微妙"
  },
  {
    "start": 476.0,
    "end": 478.0,
    "text": "あのクマをマスコットで"
  },
  {
    "start": 478.0,
    "end": 480.0,
    "text": "名前は現在募集中となっている"
  },
  {
    "start": 480.0,
    "end": 482.0,
    "text": "素晴らしいですね"
  },
  {
    "start": 482.0,
    "end": 484.0,
    "text": "運命の発展を感じます"
  },
  {
    "start": 484.0,
    "end": 486.0,
    "text": "初めて聞いた"
  },
  {
    "start": 486.0,
    "end": 487.0,
    "text": "意外に詳しいな"
  },
  {
    "start": 487.0,
    "end": 489.0,
    "text": "何が意外だ"
  },
  {
    "start": 489.0,
    "end": 491.0,
    "text": "私も氷菓子くらいは食べる"
  },
  {
    "start": 493.0,
    "end": 494.0,
    "text": "貴様"
  },
  {
    "start": 494.0,
    "end": 496.0,
    "text": "今何を考えた"
  },
  {
    "start": 496.0,
    "end": 498.0,
    "text": "マンガキシー"
  },
  {
    "start": 498.0,
    "end": 500.0,
    "text": "美味しそうですね財路"
  },
  {
    "start": 500.0,
    "end": 502.0,
    "text": "すごく美味しそうです"
  },
  {
    "start": 502.0,
    "end": 503.0,
    "text": "いかがですか?"
  },
  {
    "start": 503.0,
    "end": 505.0,
    "text": "あれを食べたくありませんか?"
  },
  {
    "start": 506.0,
    "end": 508.0,
    "text": "しかだね"
  },
  {
    "start": 509.0,
    "end": 512.0,
    "text": "じゃあ美味そうなやつを2つ"
  },
  {
    "start": 512.0,
    "end": 514.0,
    "text": "3つか"
  },
  {
    "start": 516.0,
    "end": 518.0,
    "text": "私は結構だ"
  },
  {
    "start": 518.0,
    "end": 520.0,
    "text": "軍票は労止せずに貯蓄する"
  },
  {
    "start": 520.0,
    "end": 522.0,
    "text": "だってよ"
  },
  {
    "start": 522.0,
    "end": 523.0,
    "text": "2つ頼む"
  },
  {
    "start": 523.0,
    "end": 524.0,
    "text": "買ってきてくれ"
  },
  {
    "start": 524.0,
    "end": 526.0,
    "text": "分かりました"
  },
  {
    "start": 526.0,
    "end": 528.0,
    "text": "私に任せておきなさい"
  },
  {
    "start": 528.0,
    "end": 530.0,
    "text": "財路"
  },
  {
    "start": 530.0,
    "end": 532.0,
    "text": "私は貴様に対する認識を"
  },
  {
    "start": 532.0,
    "end": 534.0,
    "text": "多少を改めた"
  },
  {
    "start": 536.0,
    "end": 538.0,
    "text": "貴様は"
  },
  {
    "start": 538.0,
    "end": 540.0,
    "text": "区分寺で私の兵を助けた"
  },
  {
    "start": 540.0,
    "end": 542.0,
    "text": "ゼワンガンでは我々が"
  },
  {
    "start": 542.0,
    "end": 544.0,
    "text": "見捨てるはずだった民間人を"
  },
  {
    "start": 544.0,
    "end": 546.0,
    "text": "救うことした"
  },
  {
    "start": 546.0,
    "end": 548.0,
    "text": "命を救われた者たちも"
  },
  {
    "start": 548.0,
    "end": 549.0,
    "text": "皆"
  },
  {
    "start": 549.0,
    "end": 551.0,
    "text": "礼を言っていた"
  },
  {
    "start": 551.0,
    "end": 553.0,
    "text": "そうか"
  },
  {
    "start": 553.0,
    "end": 555.0,
    "text": "少しは意味があったか"
  },
  {
    "start": 557.0,
    "end": 559.0,
    "text": "貴様にもマッドな笑いが"
  },
  {
    "start": 559.0,
    "end": 561.0,
    "text": "できるのだな"
  },
  {
    "start": 561.0,
    "end": 563.0,
    "text": "世の中腹の立つことが"
  },
  {
    "start": 563.0,
    "end": 565.0,
    "text": "多すぎるんだよ"
  },
  {
    "start": 565.0,
    "end": 567.0,
    "text": "とにかく貴様は"
  },
  {
    "start": 567.0,
    "end": 569.0,
    "text": "多少なりとも成果を"
  },
  {
    "start": 569.0,
    "end": 571.0,
    "text": "上げている"
  },
  {
    "start": 571.0,
    "end": 573.0,
    "text": "テオリッタ様も"
  },
  {
    "start": 573.0,
    "end": 575.0,
    "text": "貴様の契約を交わしたことで"
  },
  {
    "start": 575.0,
    "end": 577.0,
    "text": "助かったのかもしれない"
  },
  {
    "start": 577.0,
    "end": 579.0,
    "text": "貴様に対して"
  },
  {
    "start": 579.0,
    "end": 581.0,
    "text": "貴様に対して"
  },
  {
    "start": 581.0,
    "end": 583.0,
    "text": "助かったのかもしれない"
  },
  {
    "start": 583.0,
    "end": 585.0,
    "text": "どういう意味だ"
  },
  {
    "start": 585.0,
    "end": 587.0,
    "text": "テオリッタ様は"
  },
  {
    "start": 587.0,
    "end": 589.0,
    "text": "法法の遺跡にて"
  },
  {
    "start": 589.0,
    "end": 591.0,
    "text": "存在を確認された"
  },
  {
    "start": 591.0,
    "end": 593.0,
    "text": "発掘後は契約予定だった我々"
  },
  {
    "start": 593.0,
    "end": 595.0,
    "text": "第13世紀指段が"
  },
  {
    "start": 595.0,
    "end": 597.0,
    "text": "派遣され"
  },
  {
    "start": 597.0,
    "end": 599.0,
    "text": "管理と運用を任されたのだが"
  },
  {
    "start": 599.0,
    "end": 601.0,
    "text": "軍部と審伝で"
  },
  {
    "start": 601.0,
    "end": 603.0,
    "text": "対立が処置だ"
  },
  {
    "start": 603.0,
    "end": 605.0,
    "text": "そいつは大変だな"
  },
  {
    "start": 605.0,
    "end": 607.0,
    "text": "何を言う?貴様が"
  },
  {
    "start": 607.0,
    "end": 609.0,
    "text": "女神セネルバーを殺したからだ"
  },
  {
    "start": 609.0,
    "end": 611.0,
    "text": "何?"
  },
  {
    "start": 611.0,
    "end": 613.0,
    "text": "あの事件を経て"
  },
  {
    "start": 613.0,
    "end": 615.0,
    "text": "軍部は一つの発想に至った"
  },
  {
    "start": 615.0,
    "end": 617.0,
    "text": "女神が殺されるようなことが"
  },
  {
    "start": 617.0,
    "end": 619.0,
    "text": "あるなら"
  },
  {
    "start": 619.0,
    "end": 621.0,
    "text": "役に女神を増やすことはできないかと"
  },
  {
    "start": 623.0,
    "end": 625.0,
    "text": "そして軍部は"
  },
  {
    "start": 625.0,
    "end": 627.0,
    "text": "テオリッタ様の解析を希望した"
  },
  {
    "start": 629.0,
    "end": 631.0,
    "text": "解析つったって"
  },
  {
    "start": 631.0,
    "end": 633.0,
    "text": "実際は解剖だろうが"
  },
  {
    "start": 633.0,
    "end": 635.0,
    "text": "ぬろう"
  },
  {
    "start": 635.0,
    "end": 637.0,
    "text": "審伝側は反対した"
  },
  {
    "start": 637.0,
    "end": 639.0,
    "text": "だが軍部の意見が優勢だった"
  },
  {
    "start": 641.0,
    "end": 643.0,
    "text": "しかし今は"
  },
  {
    "start": 643.0,
    "end": 645.0,
    "text": "状況が変わりつつある"
  },
  {
    "start": 645.0,
    "end": 647.0,
    "text": "貴様らが短い機関で"
  },
  {
    "start": 647.0,
    "end": 649.0,
    "text": "2つの魔王現象を撃破し"
  },
  {
    "start": 649.0,
    "end": 651.0,
    "text": "テオリッタ様の有用性を"
  },
  {
    "start": 651.0,
    "end": 653.0,
    "text": "示したからだ"
  },
  {
    "start": 653.0,
    "end": 655.0,
    "text": "有用性って"
  },
  {
    "start": 655.0,
    "end": 657.0,
    "text": "あいつは役立たずだと思われていたのか"
  },
  {
    "start": 657.0,
    "end": 659.0,
    "text": "見つかったばかりなら"
  },
  {
    "start": 659.0,
    "end": 661.0,
    "text": "性能も何も"
  },
  {
    "start": 661.0,
    "end": 663.0,
    "text": "つるぎを召喚する力は"
  },
  {
    "start": 663.0,
    "end": 665.0,
    "text": "知っていた"
  },
  {
    "start": 665.0,
    "end": 667.0,
    "text": "これからだ"
  },
  {
    "start": 669.0,
    "end": 671.0,
    "text": "女神はかつて"
  },
  {
    "start": 671.0,
    "end": 673.0,
    "text": "第一次魔王討伐の頃"
  },
  {
    "start": 673.0,
    "end": 675.0,
    "text": "大文明と呼ばれる時代に"
  },
  {
    "start": 675.0,
    "end": 677.0,
    "text": "降臨したと聞く"
  },
  {
    "start": 677.0,
    "end": 679.0,
    "text": "女神とはある種のもんであり"
  },
  {
    "start": 679.0,
    "end": 681.0,
    "text": "その性質は"
  },
  {
    "start": 681.0,
    "end": 683.0,
    "text": "ここに乗って異なる"
  },
  {
    "start": 685.0,
    "end": 687.0,
    "text": "あらゆる盲毒を生む"
  },
  {
    "start": 687.0,
    "end": 689.0,
    "text": "激しい雷や嵐を呼ぶ"
  },
  {
    "start": 689.0,
    "end": 691.0,
    "text": "未来の光景を見る"
  },
  {
    "start": 691.0,
    "end": 693.0,
    "text": "魔王現象の出現に"
  },
  {
    "start": 693.0,
    "end": 695.0,
    "text": "応じて目覚め"
  },
  {
    "start": 695.0,
    "end": 697.0,
    "text": "役目が終われば"
  },
  {
    "start": 697.0,
    "end": 699.0,
    "text": "また羊で眠りにつくそうだ"
  },
  {
    "start": 701.0,
    "end": 703.0,
    "text": "女神たちの能力については"
  },
  {
    "start": 703.0,
    "end": 705.0,
    "text": "知ってるよ"
  },
  {
    "start": 705.0,
    "end": 707.0,
    "text": "タツヤの野郎も女神に"
  },
  {
    "start": 707.0,
    "end": 709.0,
    "text": "異世界から呼ばれたって"
  },
  {
    "start": 709.0,
    "end": 711.0,
    "text": "噂がたつぐらいだ"
  },
  {
    "start": 711.0,
    "end": 713.0,
    "text": "これまで発見された"
  },
  {
    "start": 713.0,
    "end": 715.0,
    "text": "12の女神たちに比べると"
  },
  {
    "start": 715.0,
    "end": 717.0,
    "text": "つるぎを召喚する能力は"
  },
  {
    "start": 717.0,
    "end": 719.0,
    "text": "数段を取ると判断された"
  },
  {
    "start": 719.0,
    "end": 721.0,
    "text": "我々は"
  },
  {
    "start": 721.0,
    "end": 723.0,
    "text": "チェオリッタ様の憂鬱をしながら"
  },
  {
    "start": 725.0,
    "end": 727.0,
    "text": "そうか"
  },
  {
    "start": 727.0,
    "end": 729.0,
    "text": "だからお前ら"
  },
  {
    "start": 729.0,
    "end": 731.0,
    "text": "不文字での自滅的な戦いは"
  },
  {
    "start": 731.0,
    "end": 733.0,
    "text": "ある種の積み彩星だったわけか"
  },
  {
    "start": 737.0,
    "end": 739.0,
    "text": "女神として役に立たないから"
  },
  {
    "start": 739.0,
    "end": 741.0,
    "text": "って何だって言うんだ"
  },
  {
    "start": 741.0,
    "end": 743.0,
    "text": "はいお待たせ"
  },
  {
    "start": 743.0,
    "end": 745.0,
    "text": "ありがとうございます"
  },
  {
    "start": 745.0,
    "end": 747.0,
    "text": "ザイロー買いましたよ"
  },
  {
    "start": 747.0,
    "end": 749.0,
    "text": "やっぱりキビ屋の文も"
  },
  {
    "start": 759.0,
    "end": 761.0,
    "text": "次の任務の話をしろ"
  },
  {
    "start": 761.0,
    "end": 763.0,
    "text": "なに"
  },
  {
    "start": 763.0,
    "end": 765.0,
    "text": "そこで結果を出せば"
  },
  {
    "start": 765.0,
    "end": 767.0,
    "text": "あいつを解剖しなくて済むんだろ"
  },
  {
    "start": 769.0,
    "end": 771.0,
    "text": "あいつの有用性だか何だかを"
  },
  {
    "start": 771.0,
    "end": 773.0,
    "text": "ガルトゥイルのクソ野郎どもに"
  },
  {
    "start": 773.0,
    "end": 775.0,
    "text": "認めさせる"
  },
  {
    "start": 777.0,
    "end": 779.0,
    "text": "防衛だ"
  },
  {
    "start": 781.0,
    "end": 783.0,
    "text": "この要塞の防衛を"
  },
  {
    "start": 783.0,
    "end": 785.0,
    "text": "貴様ら勇者だけで担ってもらう"
  },
  {
    "start": 785.0,
    "end": 787.0,
    "text": "死守だ"
  },
  {
    "start": 789.0,
    "end": 791.0,
    "text": "死守ですか"
  },
  {
    "start": 791.0,
    "end": 793.0,
    "text": "そうだ"
  },
  {
    "start": 793.0,
    "end": 795.0,
    "text": "この要塞を貴様ら勇者のみで"
  },
  {
    "start": 795.0,
    "end": 797.0,
    "text": "魔王現象から死守してもらう"
  },
  {
    "start": 797.0,
    "end": 799.0,
    "text": "つまりは死ねってわけか"
  },
  {
    "start": 799.0,
    "end": 801.0,
    "text": "ザイロ君"
  },
  {
    "start": 801.0,
    "end": 803.0,
    "text": "落ち着いてください"
  },
  {
    "start": 803.0,
    "end": 805.0,
    "text": "いきなり叩き殺したりするの"
  },
  {
    "start": 805.0,
    "end": 807.0,
    "text": "お前俺は何だと思ってやがる"
  },
  {
    "start": 807.0,
    "end": 809.0,
    "text": "すみません"
  },
  {
    "start": 809.0,
    "end": 811.0,
    "text": "師主と言いますと"
  },
  {
    "start": 811.0,
    "end": 813.0,
    "text": "どのような作戦目標でしょう"
  },
  {
    "start": 815.0,
    "end": 817.0,
    "text": "この要塞にとどまれそれだけだ"
  },
  {
    "start": 817.0,
    "end": 819.0,
    "text": "時給戦ですね"
  },
  {
    "start": 819.0,
    "end": 821.0,
    "text": "いつまで粘ればいいのでしょうか"
  },
  {
    "start": 821.0,
    "end": 823.0,
    "text": "死ぬまでだ"
  },
  {
    "start": 823.0,
    "end": 825.0,
    "text": "第9"
  },
  {
    "start": 825.0,
    "end": 827.0,
    "text": "並びに第13世紀士団は"
  },
  {
    "start": 827.0,
    "end": 829.0,
    "text": "後方で戦力を運存し"
  },
  {
    "start": 829.0,
    "end": 831.0,
    "text": "貴様らの殿滅と"
  },
  {
    "start": 831.0,
    "end": 833.0,
    "text": "要塞の観楽を持って"
  },
  {
    "start": 833.0,
    "end": 835.0,
    "text": "特殊攻撃を実行する"
  },
  {
    "start": 835.0,
    "end": 837.0,
    "text": "特殊攻撃と言うのは"
  },
  {
    "start": 837.0,
    "end": 839.0,
    "text": "毒だ"
  },
  {
    "start": 839.0,
    "end": 841.0,
    "text": "第9の女神が"
  },
  {
    "start": 841.0,
    "end": 843.0,
    "text": "奇跡をお示しになる"
  },
  {
    "start": 843.0,
    "end": 845.0,
    "text": "それで魔王が殺せるのか"
  },
  {
    "start": 845.0,
    "end": 847.0,
    "text": "どれだけ激滅作戦が"
  },
  {
    "start": 847.0,
    "end": 849.0,
    "text": "発動されても"
  },
  {
    "start": 849.0,
    "end": 851.0,
    "text": "完全に殺せなかったって"
  },
  {
    "start": 851.0,
    "end": 853.0,
    "text": "聞いてるが"
  },
  {
    "start": 853.0,
    "end": 855.0,
    "text": "その通りだ"
  },
  {
    "start": 855.0,
    "end": 857.0,
    "text": "前回の作戦では素撃により"
  },
  {
    "start": 857.0,
    "end": 859.0,
    "text": "女神の血誌毒を打ち込んだが"
  },
  {
    "start": 859.0,
    "end": 861.0,
    "text": "一時的に賢状態になっただけで"
  },
  {
    "start": 861.0,
    "end": 863.0,
    "text": "この作戦には無意味だった"
  },
  {
    "start": 863.0,
    "end": 865.0,
    "text": "サーブでも"
  },
  {
    "start": 865.0,
    "end": 867.0,
    "text": "仕留められなかったのですね"
  },
  {
    "start": 867.0,
    "end": 869.0,
    "text": "この結果と第3の女神の"
  },
  {
    "start": 869.0,
    "end": 871.0,
    "text": "未来を見る能力により"
  },
  {
    "start": 871.0,
    "end": 873.0,
    "text": "ガルツイルは作戦を修正"
  },
  {
    "start": 873.0,
    "end": 875.0,
    "text": "このミュウリッド要塞に"
  },
  {
    "start": 875.0,
    "end": 877.0,
    "text": "膨大な猛毒の罠を仕掛け"
  },
  {
    "start": 877.0,
    "end": 879.0,
    "text": "魔王を"
  },
  {
    "start": 879.0,
    "end": 881.0,
    "text": "殺し続けることに決めた"
  },
  {
    "start": 881.0,
    "end": 883.0,
    "text": "そうすれば"
  },
  {
    "start": 883.0,
    "end": 885.0,
    "text": "奴の脅威的な再生力を超えられるってか"
  },
  {
    "start": 885.0,
    "end": 887.0,
    "text": "そのために俺たちは"
  },
  {
    "start": 887.0,
    "end": 889.0,
    "text": "ただ時間を稼いで死ねと"
  },
  {
    "start": 889.0,
    "end": 891.0,
    "text": "そうだ"
  },
  {
    "start": 891.0,
    "end": 893.0,
    "text": "このミュウリッド要塞を"
  },
  {
    "start": 893.0,
    "end": 895.0,
    "text": "魔王現象15号"
  },
  {
    "start": 895.0,
    "end": 897.0,
    "text": "イブリスの母婦とせよ"
  },
  {
    "start": 897.0,
    "end": 899.0,
    "text": "あのー指揮官どの?"
  },
  {
    "start": 899.0,
    "end": 901.0,
    "text": "魔王の有因が完了した後"
  },
  {
    "start": 901.0,
    "end": 903.0,
    "text": "なぜ我々は離脱してはいけないのでしょうか"
  },
  {
    "start": 903.0,
    "end": 905.0,
    "text": "それが"
  },
  {
    "start": 905.0,
    "end": 907.0,
    "text": "ガルツイルの決定だからだ"
  },
  {
    "start": 907.0,
    "end": 909.0,
    "text": "貴様なが一人でも要塞を離れた場合"
  },
  {
    "start": 909.0,
    "end": 911.0,
    "text": "首の声音が"
  },
  {
    "start": 911.0,
    "end": 913.0,
    "text": "舞台全員を即死させる"
  },
  {
    "start": 913.0,
    "end": 915.0,
    "text": "舞台全員"
  },
  {
    "start": 915.0,
    "end": 917.0,
    "text": "ですか"
  },
  {
    "start": 917.0,
    "end": 919.0,
    "text": "ここまでする"
  },
  {
    "start": 919.0,
    "end": 921.0,
    "text": "俺たちが死なねえと不都合でも"
  },
  {
    "start": 921.0,
    "end": 923.0,
    "text": "あんのか"
  },
  {
    "start": 929.0,
    "end": 931.0,
    "text": "よっぽど嫌われているらしいな"
  },
  {
    "start": 931.0,
    "end": 933.0,
    "text": "わかりました"
  },
  {
    "start": 933.0,
    "end": 935.0,
    "text": "作戦は果たします"
  },
  {
    "start": 935.0,
    "end": 937.0,
    "text": "ですが何点か"
  },
  {
    "start": 937.0,
    "end": 939.0,
    "text": "作戦の改善をお願いします"
  },
  {
    "start": 939.0,
    "end": 941.0,
    "text": "改善?"
  },
  {
    "start": 941.0,
    "end": 943.0,
    "text": "まず我々が一人でも要塞から離れたら"
  },
  {
    "start": 943.0,
    "end": 945.0,
    "text": "全員が死ぬという規則"
  },
  {
    "start": 945.0,
    "end": 947.0,
    "text": "それは大変まずいです"
  },
  {
    "start": 947.0,
    "end": 949.0,
    "text": "なぜだ"
  },
  {
    "start": 949.0,
    "end": 951.0,
    "text": "我々は人格破綻者だらけの犯罪者集"
  },
  {
    "start": 951.0,
    "end": 953.0,
    "text": "なんですよ"
  },
  {
    "start": 953.0,
    "end": 955.0,
    "text": "さっさと要塞を抜け出して楽になろう"
  },
  {
    "start": 955.0,
    "end": 957.0,
    "text": "とするものが想定されます"
  },
  {
    "start": 957.0,
    "end": 959.0,
    "text": "作戦どころではありません"
  },
  {
    "start": 959.0,
    "end": 961.0,
    "text": "なので"
  },
  {
    "start": 961.0,
    "end": 963.0,
    "text": "誰か一人ではなく全員が離脱したら"
  },
  {
    "start": 963.0,
    "end": 965.0,
    "text": "皆殺しということにするべきです"
  },
  {
    "start": 965.0,
    "end": 967.0,
    "text": "その方がより確実に"
  },
  {
    "start": 967.0,
    "end": 969.0,
    "text": "作戦を遂行できるかと"
  },
  {
    "start": 969.0,
    "end": 971.0,
    "text": "ああそれと"
  },
  {
    "start": 971.0,
    "end": 973.0,
    "text": "テオリッタ様についてですが"
  },
  {
    "start": 973.0,
    "end": 975.0,
    "text": "我々が女神は"
  },
  {
    "start": 975.0,
    "end": 977.0,
    "text": "おじひの心がおつよくあられる"
  },
  {
    "start": 977.0,
    "end": 979.0,
    "text": "周囲が反対しても"
  },
  {
    "start": 979.0,
    "end": 981.0,
    "text": "要塞にとどまるでしょう"
  },
  {
    "start": 981.0,
    "end": 983.0,
    "text": "その許可を願います"
  },
  {
    "start": 983.0,
    "end": 985.0,
    "text": "私は許可を出す立場にない"
  },
  {
    "start": 985.0,
    "end": 987.0,
    "text": "女神は軍令上"
  },
  {
    "start": 987.0,
    "end": 989.0,
    "text": "第13世紀師団の管理課にあり"
  },
  {
    "start": 989.0,
    "end": 991.0,
    "text": "財力君"
  },
  {
    "start": 991.0,
    "end": 993.0,
    "text": "今すぐキビア団長に連絡をとってください"
  },
  {
    "start": 993.0,
    "end": 995.0,
    "text": "ああ"
  },
  {
    "start": 999.0,
    "end": 1001.0,
    "text": "あとは何が欲しいですか"
  },
  {
    "start": 1001.0,
    "end": 1003.0,
    "text": "兵隊が人手が足りない"
  },
  {
    "start": 1003.0,
    "end": 1005.0,
    "text": "分かりました"
  },
  {
    "start": 1005.0,
    "end": 1006.0,
    "text": "あとは?"
  },
  {
    "start": 1006.0,
    "end": 1007.0,
    "text": "武器と食料"
  },
  {
    "start": 1007.0,
    "end": 1008.0,
    "text": "分かりました"
  },
  {
    "start": 1008.0,
    "end": 1009.0,
    "text": "あとは?"
  },
  {
    "start": 1009.0,
    "end": 1010.0,
    "text": "恩者"
  },
  {
    "start": 1010.0,
    "end": 1011.0,
    "text": "分かりました"
  },
  {
    "start": 1011.0,
    "end": 1012.0,
    "text": "あとは?"
  },
  {
    "start": 1013.0,
    "end": 1015.0,
    "text": "恩者は嘘だ"
  },
  {
    "start": 1015.0,
    "end": 1018.0,
    "text": "できれば奇兵と方兵が欲しい"
  },
  {
    "start": 1018.0,
    "end": 1020.0,
    "text": "ジェイスとライノは呼び戻せるか"
  },
  {
    "start": 1020.0,
    "end": 1023.0,
    "text": "二人はまだ西野先生ですよ"
  },
  {
    "start": 1023.0,
    "end": 1025.0,
    "text": "サーブなら戻ってくるでしょうが"
  },
  {
    "start": 1026.0,
    "end": 1027.0,
    "text": "サーブか"
  },
  {
    "start": 1027.0,
    "end": 1030.0,
    "text": "おい!何をこそこそ話している!"
  },
  {
    "start": 1030.0,
    "end": 1032.0,
    "text": "もうザイロ君"
  },
  {
    "start": 1032.0,
    "end": 1034.0,
    "text": "キビア団長の部屋ならあそこじゃないですか"
  },
  {
    "start": 1034.0,
    "end": 1036.0,
    "text": "ああ"
  },
  {
    "start": 1036.0,
    "end": 1038.0,
    "text": "じゃああとはうまくやっておきますよ"
  },
  {
    "start": 1038.0,
    "end": 1040.0,
    "text": "私を信じてください"
  },
  {
    "start": 1040.0,
    "end": 1042.0,
    "text": "全く信用できねぇな"
  },
  {
    "start": 1042.0,
    "end": 1044.0,
    "text": "本当にやれるのか"
  },
  {
    "start": 1044.0,
    "end": 1046.0,
    "text": "なんていうか"
  },
  {
    "start": 1046.0,
    "end": 1049.0,
    "text": "皆さんは信じないでしょうけど"
  },
  {
    "start": 1049.0,
    "end": 1051.0,
    "text": "私はね"
  },
  {
    "start": 1051.0,
    "end": 1053.0,
    "text": "こう見えて"
  },
  {
    "start": 1053.0,
    "end": 1055.0,
    "text": "世界を救う一歩手前まで"
  },
  {
    "start": 1055.0,
    "end": 1057.0,
    "text": "言った男なんです"
  },
  {
    "start": 1061.0,
    "end": 1064.0,
    "text": "ずいぶんインキな場所ですね"
  },
  {
    "start": 1064.0,
    "end": 1068.0,
    "text": "裁判所に連行されるはずではなかったのですか?"
  },
  {
    "start": 1068.0,
    "end": 1070.0,
    "text": "申し訳ない"
  },
  {
    "start": 1070.0,
    "end": 1072.0,
    "text": "ベネティム・レオプール"
  },
  {
    "start": 1072.0,
    "end": 1075.0,
    "text": "本来ならもう少しマシな部屋で話したかった"
  },
  {
    "start": 1075.0,
    "end": 1078.0,
    "text": "僕は君に会いたかったんだよ"
  },
  {
    "start": 1078.0,
    "end": 1080.0,
    "text": "尊敬すらしているんだ"
  },
  {
    "start": 1080.0,
    "end": 1082.0,
    "text": "尊敬?"
  },
  {
    "start": 1082.0,
    "end": 1085.0,
    "text": "あなたも詐欺で政敬を立てたいんですか?"
  },
  {
    "start": 1085.0,
    "end": 1089.0,
    "text": "それなら私みたいなのは尊敬してはいけませんよ"
  },
  {
    "start": 1089.0,
    "end": 1092.0,
    "text": "結局捕まってしまいましたし"
  },
  {
    "start": 1092.0,
    "end": 1093.0,
    "text": "そうだね"
  },
  {
    "start": 1093.0,
    "end": 1095.0,
    "text": "全くその通りだ"
  },
  {
    "start": 1095.0,
    "end": 1098.0,
    "text": "やはり罪の重さとしては"
  },
  {
    "start": 1098.0,
    "end": 1101.0,
    "text": "大きいをサーカス団に売り飛ばそうとした"
  },
  {
    "start": 1101.0,
    "end": 1103.0,
    "text": "意見がまずかったのでしょうか"
  },
  {
    "start": 1103.0,
    "end": 1104.0,
    "text": "ああ"
  },
  {
    "start": 1104.0,
    "end": 1107.0,
    "text": "あれはかつてない犯罪だったね"
  },
  {
    "start": 1107.0,
    "end": 1109.0,
    "text": "オートで購入していたサーカス団に"
  },
  {
    "start": 1109.0,
    "end": 1111.0,
    "text": "敷地を売却するために"
  },
  {
    "start": 1111.0,
    "end": 1114.0,
    "text": "オートの移転まで出ち上げるとは"
  },
  {
    "start": 1114.0,
    "end": 1116.0,
    "text": "すごいな"
  },
  {
    "start": 1116.0,
    "end": 1121.0,
    "text": "本当なら毎金をもらって逃げるつもりだったんですけどね"
  },
  {
    "start": 1121.0,
    "end": 1123.0,
    "text": "他にも投資さぎ"
  },
  {
    "start": 1123.0,
    "end": 1126.0,
    "text": "こっと貧義そうに偽札づくり"
  },
  {
    "start": 1126.0,
    "end": 1130.0,
    "text": "バークル開拓校舎からは100件ほどの訴えがあったよ"
  },
  {
    "start": 1130.0,
    "end": 1133.0,
    "text": "すみません 犯罪はしてます"
  },
  {
    "start": 1133.0,
    "end": 1135.0,
    "text": "犯罪は結構だ"
  },
  {
    "start": 1135.0,
    "end": 1136.0,
    "text": "それより"
  },
  {
    "start": 1136.0,
    "end": 1140.0,
    "text": "なんで詐欺をやろうと思ったのかな"
  },
  {
    "start": 1140.0,
    "end": 1145.0,
    "text": "実は子供の頃から人のがっかりする顔を見るのが苦手でして"
  },
  {
    "start": 1145.0,
    "end": 1148.0,
    "text": "その場しのぎで適当な嘘をついて"
  },
  {
    "start": 1148.0,
    "end": 1151.0,
    "text": "長寿りを合わせようとしてしまうんです"
  },
  {
    "start": 1151.0,
    "end": 1154.0,
    "text": "その努力は大したものだよ"
  },
  {
    "start": 1154.0,
    "end": 1158.0,
    "text": "よくもまあこれだけ大きな計画の長寿りを合わせたね"
  },
  {
    "start": 1158.0,
    "end": 1160.0,
    "text": "ああ"
  },
  {
    "start": 1160.0,
    "end": 1164.0,
    "text": "あの私は死刑になるのでしょうか"
  },
  {
    "start": 1164.0,
    "end": 1167.0,
    "text": "いや残念ながら違う"
  },
  {
    "start": 1167.0,
    "end": 1171.0,
    "text": "実のところ君は詐欺罪で裁かれるわけじゃない"
  },
  {
    "start": 1171.0,
    "end": 1173.0,
    "text": "詐欺じゃない"
  },
  {
    "start": 1173.0,
    "end": 1174.0,
    "text": "だったら"
  },
  {
    "start": 1174.0,
    "end": 1176.0,
    "text": "まずかったのはこっちだよ"
  },
  {
    "start": 1176.0,
    "end": 1180.0,
    "text": "それは私が以前に努めていた三流氏ですね"
  },
  {
    "start": 1180.0,
    "end": 1182.0,
    "text": "それが何か"
  },
  {
    "start": 1182.0,
    "end": 1184.0,
    "text": "君が描いた記事さ"
  },
  {
    "start": 1184.0,
    "end": 1186.0,
    "text": "すでに神殿やガルトゥイル"
  },
  {
    "start": 1186.0,
    "end": 1188.0,
    "text": "果ては王族に至るまで"
  },
  {
    "start": 1188.0,
    "end": 1191.0,
    "text": "魔王現象に影響されたスパイが"
  },
  {
    "start": 1191.0,
    "end": 1195.0,
    "text": "人間の振り押しで入り込んでいるんだって"
  },
  {
    "start": 1195.0,
    "end": 1196.0,
    "text": "はぁ"
  },
  {
    "start": 1196.0,
    "end": 1198.0,
    "text": "確かに描きましたね"
  },
  {
    "start": 1198.0,
    "end": 1200.0,
    "text": "聖騎士と女神のスキャンダルや"
  },
  {
    "start": 1200.0,
    "end": 1203.0,
    "text": "王家の終文もネタ切れでしたし"
  },
  {
    "start": 1203.0,
    "end": 1207.0,
    "text": "もっと人の不安を合おるような記事が欲しいと言われましたので"
  },
  {
    "start": 1207.0,
    "end": 1208.0,
    "text": "ふん"
  },
  {
    "start": 1208.0,
    "end": 1211.0,
    "text": "うーん正直言うとね"
  },
  {
    "start": 1211.0,
    "end": 1212.0,
    "text": "差にもいい"
  },
  {
    "start": 1212.0,
    "end": 1214.0,
    "text": "偽造もスキャンダルも"
  },
  {
    "start": 1214.0,
    "end": 1216.0,
    "text": "陰謀論も"
  },
  {
    "start": 1216.0,
    "end": 1218.0,
    "text": "好きにすればいい"
  },
  {
    "start": 1218.0,
    "end": 1220.0,
    "text": "ただ"
  },
  {
    "start": 1220.0,
    "end": 1223.0,
    "text": "真実だけは困るんだ"
  },
  {
    "start": 1223.0,
    "end": 1225.0,
    "text": "えっ"
  },
  {
    "start": 1225.0,
    "end": 1230.0,
    "text": "僕に君にはデッチ上げた話を人に信じさせる能力がある"
  },
  {
    "start": 1230.0,
    "end": 1234.0,
    "text": "少なくとも我々にそう思わせるだけの能力が"
  },
  {
    "start": 1234.0,
    "end": 1235.0,
    "text": "えっ"
  },
  {
    "start": 1235.0,
    "end": 1236.0,
    "text": "ああいやいや"
  },
  {
    "start": 1236.0,
    "end": 1237.0,
    "text": "待ってくださいよ"
  },
  {
    "start": 1237.0,
    "end": 1238.0,
    "text": "私は"
  },
  {
    "start": 1238.0,
    "end": 1241.0,
    "text": "真実を喋ることができないよ"
  },
  {
    "start": 1241.0,
    "end": 1245.0,
    "text": "君の声音には特別な仕掛けを施す"
  },
  {
    "start": 1247.0,
    "end": 1248.0,
    "text": "えっ"
  },
  {
    "start": 1248.0,
    "end": 1249.0,
    "text": "ちょっと"
  },
  {
    "start": 1249.0,
    "end": 1250.0,
    "text": "残念ながら"
  },
  {
    "start": 1250.0,
    "end": 1251.0,
    "text": "待ってください"
  },
  {
    "start": 1251.0,
    "end": 1254.0,
    "text": "経営どころでは済まされない"
  },
  {
    "start": 1254.0,
    "end": 1256.0,
    "text": "そんな"
  },
  {
    "start": 1256.0,
    "end": 1257.0,
    "text": "私は"
  },
  {
    "start": 1257.0,
    "end": 1259.0,
    "text": "何もし知りません"
  },
  {
    "start": 1259.0,
    "end": 1260.0,
    "text": "ただ"
  },
  {
    "start": 1260.0,
    "end": 1263.0,
    "text": "かっかりさせたくなかっただけで"
  },
  {
    "start": 1263.0,
    "end": 1264.0,
    "text": "ん"
  },
  {
    "start": 1264.0,
    "end": 1267.0,
    "text": "ベネピムレオプール"
  },
  {
    "start": 1267.0,
    "end": 1268.0,
    "text": "あっ"
  },
  {
    "start": 1268.0,
    "end": 1269.0,
    "text": "君を"
  },
  {
    "start": 1269.0,
    "end": 1270.0,
    "text": "あっ"
  },
  {
    "start": 1270.0,
    "end": 1272.0,
    "text": "輸射系に射す"
  },
  {
    "start": 1276.0,
    "end": 1280.0,
    "text": "まさか本当に音車以外の要求を通しちまうとは"
  },
  {
    "start": 1280.0,
    "end": 1283.0,
    "text": "もし女神様が危なくなったら"
  },
  {
    "start": 1283.0,
    "end": 1285.0,
    "text": "ベネピムが脱出させることになったんでしょ"
  },
  {
    "start": 1285.0,
    "end": 1288.0,
    "text": "ほんとちゃっかりしてるやね"
  },
  {
    "start": 1288.0,
    "end": 1289.0,
    "text": "あいつ"
  },
  {
    "start": 1289.0,
    "end": 1292.0,
    "text": "いつか戦場の動作され殺されるかもな"
  },
  {
    "start": 1292.0,
    "end": 1294.0,
    "text": "それより"
  },
  {
    "start": 1294.0,
    "end": 1296.0,
    "text": "サーブはもう着任してるんだろうな"
  },
  {
    "start": 1296.0,
    "end": 1298.0,
    "text": "たぶんね"
  },
  {
    "start": 1298.0,
    "end": 1299.0,
    "text": "はぁ"
  },
  {
    "start": 1299.0,
    "end": 1303.0,
    "text": "ベネピムの方がまだマシなのかもしれないね"
  },
  {
    "start": 1303.0,
    "end": 1304.0,
    "text": "サーブ"
  },
  {
    "start": 1304.0,
    "end": 1307.0,
    "text": "なんかすぐ問題起こしそうだし"
  },
  {
    "start": 1307.0,
    "end": 1309.0,
    "text": "もとより上がった"
  },
  {
    "start": 1309.0,
    "end": 1311.0,
    "text": "おいおい止まらねえぞ"
  },
  {
    "start": 1311.0,
    "end": 1313.0,
    "text": "もう7回目だ"
  },
  {
    "start": 1313.0,
    "end": 1314.0,
    "text": "よっ"
  },
  {
    "start": 1317.0,
    "end": 1319.0,
    "text": "また大晴れだ"
  },
  {
    "start": 1320.0,
    "end": 1322.0,
    "text": "またいただきだな"
  },
  {
    "start": 1322.0,
    "end": 1325.0,
    "text": "ほらさっさと追加の軍兵をよこす"
  },
  {
    "start": 1325.0,
    "end": 1328.0,
    "text": "うわぁそういうことやっちゃいます"
  },
  {
    "start": 1329.0,
    "end": 1331.0,
    "text": "もんくあんのか"
  },
  {
    "start": 1331.0,
    "end": 1332.0,
    "text": "いや実は俺"
  },
  {
    "start": 1332.0,
    "end": 1335.0,
    "text": "めっちゃ耳と目がいいんすよね"
  },
  {
    "start": 1335.0,
    "end": 1338.0,
    "text": "ほら俺って正義の男なんで"
  },
  {
    "start": 1338.0,
    "end": 1341.0,
    "text": "悪さするやつは許せない人じゃないすか"
  },
  {
    "start": 1341.0,
    "end": 1344.0,
    "text": "ま、今すぐ軍兵を置いて消えるならさかまでひどいこと"
  },
  {
    "start": 1344.0,
    "end": 1345.0,
    "text": "てめぇい"
  },
  {
    "start": 1345.0,
    "end": 1347.0,
    "text": "言いかけにしろよ"
  },
  {
    "start": 1347.0,
    "end": 1349.0,
    "text": "うだうだって人なこと抜かして"
  },
  {
    "start": 1356.0,
    "end": 1358.0,
    "text": "いらないっすよね"
  },
  {
    "start": 1358.0,
    "end": 1361.0,
    "text": "いかさまするような悪いでは"
  },
  {
    "start": 1361.0,
    "end": 1363.0,
    "text": "ああ"
  },
  {
    "start": 1366.0,
    "end": 1368.0,
    "text": "だからいったんすけどね"
  },
  {
    "start": 1369.0,
    "end": 1371.0,
    "text": "それにしても"
  },
  {
    "start": 1377.0,
    "end": 1379.0,
    "text": "腹減ったなぁ"
  },
  {
    "start": 1391.0,
    "end": 1393.0,
    "text": "す"
  },
  {
    "start": 1398.0,
    "end": 1401.0,
    "text": "Let's get out of this hell"
  },
  {
    "start": 1411.0,
    "end": 1415.0,
    "text": "崩れ落ちた夢の泣き柄を"
  },
  {
    "start": 1415.0,
    "end": 1420.0,
    "text": "踏みつけてもなにも感じられない"
  },
  {
    "start": 1420.0,
    "end": 1424.68,
    "text": "あの時こうしてなかったらなんて"
  },
  {
    "start": 1424.68,
    "end": 1428.98,
    "text": "耳鳴りのよう 捉われたまま"
  },
  {
    "start": 1428.98,
    "end": 1434.98,
    "text": "事故がないなら 口だままと"
  },
  {
    "start": 1434.98,
    "end": 1438.1,
    "text": "誓いも果たせるかい?"
  },
  {
    "start": 1438.1,
    "end": 1440.4,
    "text": "What if we take"
  },
  {
    "start": 1440.4,
    "end": 1443.3,
    "text": "繋がれた未来"
  },
  {
    "start": 1443.3,
    "end": 1447.26,
    "text": "はったき放てるまで"
  },
  {
    "start": 1447.26,
    "end": 1449.56,
    "text": "何十回だった"
  },
  {
    "start": 1449.72,
    "end": 1452.3,
    "text": "何百回だっていいの?"
  },
  {
    "start": 1452.3,
    "end": 1455.62,
    "text": "ぼや 涙をくわい"
  },
  {
    "start": 1455.62,
    "end": 1457.62,
    "text": "Just give us a nice"
  },
  {
    "start": 1459.6799999999998,
    "end": 1463.6799999999998,
    "text": "Let's be our best cycle"
  }
]